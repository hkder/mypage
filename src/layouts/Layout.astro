---
import '../styles/tokens.css';
import '../styles/styles.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../lib/posts';
interface Props {
    readonly title: string;
    readonly description?: string;
    readonly current?: 'posts' | 'tags' | 'about';
    readonly article?: boolean;
    readonly home?: boolean;
    readonly noindex?: boolean;
}
const { title, description = site.description, current, article = false, home = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title} · {site.title}</title>
        <meta name="description" content={description} />
        <link rel="preload" href="/fonts/merriweather-regular-latin.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=tree" />
        <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
        <link rel="alternate" type="application/atom+xml" title={site.title} href="/atom.xml" />
        <meta property="og:title" content={`${title} · ${site.title}`} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content={article ? 'article' : 'website'} />
        <meta property="og:site_name" content={site.title} />
        {noindex && <meta name="robots" content="noindex" />}
    </head>
    <body>
        {article && <div class="progress" aria-hidden="true"><span></span></div>}
        <a class="skip" href="#main">Skip to content</a>
        <div class:list={['shell', { 'home-shell': home }]} >
            <SiteHeader current={current} />
            <slot />
            <SiteFooter />
        </div>
    </body>
</html>
