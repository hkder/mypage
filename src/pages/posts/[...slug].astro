---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Toc from '../../components/Toc.astro';
import { publishedPosts, formatDate, readingTime, site, type Post } from '../../lib/posts';
export async function getStaticPaths() {
    return (await publishedPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { readonly post: Post }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Layout title={post.data.title} description={post.data.summary} current="posts" article>
    <main id="main" class="reader-layout">
        <article class="reader">
            <header class="reader-heading">
                <p class="eyebrow">{post.data.tags[0]?.replaceAll('-', ' ') ?? 'Notes'}</p>
                <h1>{post.data.title}</h1>
                <div class="meta">
                    <span>{site.name}</span><span class="dot" aria-hidden="true"></span><span>{readingTime(post)} min read</span><span class="dot" aria-hidden="true"></span>
                    <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
                    {post.data.updated && <span>Updated <time datetime={post.data.updated.toISOString().slice(0, 10)}>{formatDate(post.data.updated)}</time></span>}
                </div>
            </header>
            <Toc headings={headings} />
            <div class="article-body"><Content /></div>
        </article>
    </main>
</Layout>
<script>
    import '../../scripts/article.js';
</script>
