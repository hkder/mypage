---
import Layout from '../../layouts/Layout.astro';
import PostRows from '../../components/PostRows.astro';
import { publishedPosts, tagsFor } from '../../lib/posts';
const tags = tagsFor(await publishedPosts());
---
<Layout title="Tags" current="tags">
    <main id="main" class="about-page">
        <h1>Tags</h1>
        {tags.map(({ tag, posts }) => <section class="tag-group"><h2><a href={`/tags/${tag}/`}>{tag}</a> <span class="count">({posts.length})</span></h2><div class="archive-year"><PostRows posts={posts} fullDate /></div></section>)}
        {tags.length === 0 && <p>No tags yet.</p>}
    </main>
</Layout>
