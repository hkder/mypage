---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Rail from '../../components/Rail.astro';
import { publishedPosts, tagsFor, type Post } from '../../lib/posts';
export async function getStaticPaths() {
    return tagsFor(await publishedPosts()).map(({ tag, posts }) => ({ params: { tag }, props: { tag, posts } }));
}
interface Props { readonly tag: string; readonly posts: readonly Post[] }
const { tag, posts } = Astro.props;
const allPosts = await publishedPosts();
---
<Layout title={tag} description={`Posts about ${tag} by Hosung Kim.`} current="tags">
    <main id="main" class="main main--list">
        <h1 class="list-heading">{tag} <span class="count">({posts.length})</span></h1>
        <PostList posts={posts} />
    </main>
    <Rail posts={allPosts} />
</Layout>
