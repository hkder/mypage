---
import { site } from '../lib/posts';
---
<footer class="footer">
    <div class="footer-credit">
        <p>© {new Date().getUTCFullYear()} {site.name}</p>
        <p class="license">Writing &amp; snippets: <a href="https://creativecommons.org/licenses/by-nc/4.0/" rel="license noopener noreferrer" target="_blank">CC BY-NC 4.0</a></p>
    </div>
    <a id="writing-shortcut" class="writing-shortcut" href="https://hosung-author.hosungk.workers.dev/" aria-label="Private writing" title="Private writing" hidden>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="4" /><path d="m11 11 9 9m-3-3 3-3m-6 0 3-3" /></svg>
    </a>
</footer>

<script>
    const shortcut = document.querySelector<HTMLAnchorElement>('#writing-shortcut');
    const brand = document.querySelector<HTMLAnchorElement>('.brand');
    function showShortcut(focus = false) {
        try { localStorage.setItem('hosung-writing-shortcut', '1'); }
        catch { /* The shortcut remains usable on this page without storage. */ }
        if (!shortcut) return;
        shortcut.hidden = false;
        if (focus) {
            shortcut.focus({ preventScroll: true });
            shortcut.scrollIntoView({ block: 'center' });
        }
    }
    const url = new URL(window.location.href);
    const enable = url.searchParams.get('writer') === '1';
    try {
        if (shortcut) shortcut.hidden = localStorage.getItem('hosung-writing-shortcut') !== '1';
    } catch { /* Ordinary visits stay hidden when browser storage is unavailable. */ }
    if (enable) {
        showShortcut();
        url.searchParams.delete('writer');
        history.replaceState(history.state, '', url);
    }
    let press: { id: number; time: number; x: number; y: number } | undefined;
    let suppressClick = false;
    const cancel = () => { press = undefined; };
    brand?.addEventListener('pointerdown', event => {
        cancel(); suppressClick = false;
        if (event.button !== 0 || !event.isPrimary || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey
            || !(event.target instanceof HTMLImageElement)) return;
        press = { id: event.pointerId, time: performance.now(), x: event.clientX, y: event.clientY };
    });
    window.addEventListener('pointermove', event => {
        if (press && event.pointerId === press.id && Math.hypot(event.clientX - press.x, event.clientY - press.y) > 12) cancel();
    });
    window.addEventListener('pointerup', event => {
        if (!press || event.pointerId !== press.id) return;
        const held = performance.now() - press.time >= 2000;
        cancel();
        if (!held) return;
        suppressClick = true;
        requestAnimationFrame(() => showShortcut(true));
    });
    brand?.addEventListener('click', event => {
        if (suppressClick) { event.preventDefault(); suppressClick = false; }
    });
    brand?.addEventListener('contextmenu', event => { if (press) event.preventDefault(); });
    brand?.addEventListener('pointerleave', cancel);
    window.addEventListener('pointercancel', cancel);
    window.addEventListener('blur', cancel);
    brand?.addEventListener('keydown', event => {
        if (event.key === 'Escape') cancel();
        if (event.key === 'Enter' && event.shiftKey) { event.preventDefault(); showShortcut(true); }
    });
</script>
