---
import { site } from '../lib/posts';
interface Props { readonly current?: 'posts' | 'tags' | 'about' }
const { current } = Astro.props;
---
<header class="header">
    <div class="brand">
        <a class="owner-link" href="https://hosung-author.hosungk.workers.dev/" aria-label="Owner sign-in" title="Owner sign-in"><img src="/favicon.svg?v=tree" alt="" width="35" height="35" /></a>
        <a class="brand-home" href="/">{site.title}</a>
    </div>
    <nav class="nav" aria-label="Main">
        <a href="/#notes" aria-current={current === 'posts' && Astro.url.pathname === '/' ? 'page' : undefined}>Notes</a>
        <a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a>
        <a href={site.github}>GitHub ↗</a>
    </nav>
</header>
